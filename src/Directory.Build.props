<Project>

  <!-- MSBuild stops at the first Directory.Build.props it finds, so the repository-wide one is pulled in by
       hand. The search starts one level above this file so that it lands on the repository root here and on
       the mirror's root there, where this slice's src/ sits directly under it. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version>$(GraphVersion)</Version>

    <Authors>Aki Evans</Authors>
    <Copyright>Copyright (c) 2026 Aki Evans</Copyright>
    <!-- This slice's own mirror, not the framework's. -->
    <PackageProjectUrl>https://github.com/AkiEvansDev/NE.Standard.UI.Graph</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AkiEvansDev/NE.Standard.UI.Graph</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- Symbols and sources inside the assembly, since no commit hash can point a debugger at the mirror: a consumer steps
         into the package and reads its line numbers with nothing else to download. -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
    <!-- The framework's licence: a component is only useful inside it. A file rather than an expression,
         since Prosperity has no SPDX expression NuGet accepts. -->
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
