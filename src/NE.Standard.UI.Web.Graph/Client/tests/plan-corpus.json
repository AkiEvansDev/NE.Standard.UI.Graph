        {"kind": "Resource", "id": "ore"},
        {"kind": "Resource", "id": "ingot"},
        {"kind": "Resource", "id": "plate"},
        {"kind": "Craft", "id": "smelt", "time": 2, "ingredients": [{"resource": "ore", "amount": 1}], "products": [{"resource": "ingot", "amount": 1}]},
        {"kind": "Craft", "id": "press", "time": 3, "ingredients": [{"resource": "ingot", "amount": 2}], "products": [{"resource": "plate", "amount": 1}]}
      ],
      "request": {"targets": [{"resource": "plate", "amount": 5}], "period": "Once", "objective": "LeastRaw"},
      "expected": {"status": "Solved", "runs": {"smelt": 10, "press": 5}, "surplus": {}, "time": 35, "raw": 10, "cost": 10}
    },
